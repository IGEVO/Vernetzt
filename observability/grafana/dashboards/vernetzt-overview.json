{
  "uid": "vernetzt-overview",
  "title": "Vernetzt - Betrieb",
  "description": "Betriebsübersicht: HTTP (Rate, Fehler, Latenz), Rate Limiting, Backups, .NET-Laufzeit und Fehler-Logs.",
  "tags": [
    "vernetzt",
    "otel",
    "overview"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "timepicker": {},
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "vernetzt"
      ],
      "asDropdown": true,
      "title": "Vernetzt-Dashboards",
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "label": "Metriken",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "loki_ds",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "vernetzt",
          "value": "vernetzt"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "env",
        "label": "Umgebung",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service\"}, deployment_environment)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service\"}, deployment_environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Zustand jetzt",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Anfragen/s",
      "description": "Alle HTTP-Anfragen an die API, ohne Health-Checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$env\",http_route!~\"health.*\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "5xx-Quote",
      "description": "Anteil der Serverfehler an allen Anfragen. Alert ab 5 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$env\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",deployment_environment=~\"$env\"}[$__rate_interval])), 1e-9)",
          "refId": "A",
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Latenz p95",
      "description": "95 % der Anfragen sind schneller. Alert ab 2 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",deployment_environment=~\"$env\",http_route!~\"health.*\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Gedrosselt (429)/min",
      "description": "Vom Rate-Limiter abgewiesene Anfragen pro Minute. Viele davon deuten auf Fehlkonfiguration (Proxy-IP) oder Missbrauch.",

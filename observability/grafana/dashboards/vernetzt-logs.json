      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (detected_level, scope_name, _OriginalFormat_) (count_over_time({service_name=~\"$service\"} | scope_name=~\"$scope\" |~ \"(?i)$search\" | detected_level=~\"error|critical|fatal|warn\" [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [

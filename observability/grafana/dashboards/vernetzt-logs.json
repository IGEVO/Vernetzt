          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "detected_level": "Level",
              "scope_name": "Komponente",
              "_OriginalFormat_": "Meldung (Template)",
              "Value": "Anzahl",
              "Value #A": "Anzahl"
            }
          }
        }

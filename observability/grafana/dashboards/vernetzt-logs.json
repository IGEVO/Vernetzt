{
  "uid": "vernetzt-logs",
  "title": "Vernetzt - Logs",
  "tags": [
    "vernetzt",
    "otel",
    "logs"
  ],
  "description": "Allgemeine Log-Auswertung: Volumen nach Level, häufigste Fehler und Warnungen, Exceptions und durchsuchbare Log-Ansicht.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "timepicker": {},
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "vernetzt"
      ],
      "asDropdown": true,
      "title": "Vernetzt-Dashboards",
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki_ds",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki_ds}"
        },
        "definition": "label_values(service_name)",
        "query": {
          "type": 1,
          "label": "service_name",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,critical,fatal,warn,info,debug,trace",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "hide": 0
      },
      {
        "name": "scope",
        "label": "Komponente (Regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Textsuche",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Überblick im gewählten Zeitraum",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Log-Zeilen",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"$service\"} | scope_name=~\"$scope\" |~ \"(?i)$search\" | detected_level=~\"${level:regex}\" [$__range]))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4

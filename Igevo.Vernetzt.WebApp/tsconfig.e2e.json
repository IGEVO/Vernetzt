{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["tests/e2e/**/*.ts", "tests/integration/**/*.ts", "src/types/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}

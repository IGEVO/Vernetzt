{
  "name": "igevo-vernetzt-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "playwright test -c playwright.integration.config.ts",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/types/generated-api.ts --immutable",
    "api:check": "openapi-typescript openapi/openapi.json -o src/types/generated-api.ts --immutable --check",
    "api:snapshot": "node scripts/update-openapi.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.106.0",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "cropperjs": "^2.3.1",
    "dompurify": "^3.3.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.0.4",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.13",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGEVO/Vernetzt.git",
    "directory": "Igevo.Vernetzt.WebApp"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5",
    "glob@>=9.0.0 <14.0.2": "^14.0.4"
  }
}

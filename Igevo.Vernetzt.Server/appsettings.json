{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;::1",
  "App": {
    "SystemAdminEmail": "admin@example.com",
    "BaseUrl": "https://your-domain.com",
    "AuditLogRetentionDays": 90,
    "ExpiredTokenRetentionDays": 30
  },
  "Health": {
    "Token": "CHANGE-THIS-TO-A-SECURE-RANDOM-TOKEN"
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "PublicApi": {
      "PermitLimit": 120
    },
    "PublicContactReveal": {
      "PermitLimit": 10
    }
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "UseSsl": true,
      "Username": "CHANGE-THIS-TO-YOUR-SMTP-USERNAME",
      "Password": "CHANGE-THIS-TO-YOUR-SMTP-PASSWORD"
    },
    "From": {
      "Address": "noreply@example.com",
      "Name": "Vernetzt"
    },
    "Retry": {
      "MaxRetries": 3,
      "InitialDelaySeconds": 2,
      "UseExponentialBackoff": true,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerDurationSeconds": 300
    }
  },
  "EmailRelay": {
    "Enabled": false,
    "TokenValidityMinutes": 30,
    "PollingIntervalSeconds": 60,
    "BaseAddress": "relay@example.com",
    "AddressingMode": "PlusAddressing",
    "MonitorMode": "Imap",
    "AddInfoBanner": true,
    "SendSummaryReply": true,
    "MaxActiveTokensPerUser": 10,
    "MaxMessageSizeBytes": 20971520,
    "MaxMessagesPerPoll": 25,
    "MailboxRetentionHours": 24,
    "Imap": {
      "Host": "imap.example.com",
      "Port": 993,
      "UseSsl": true,
      "Username": "CHANGE-THIS",
      "Password": "CHANGE-THIS"
    },
    "Pop3": {
      "Host": "pop3.example.com",
      "Port": 995,
      "UseSsl": true,
      "Username": "CHANGE-THIS",
      "Password": "CHANGE-THIS"
    }
  },
  "Storage": {
    "RootPath": "/app/uploads"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/vernetzt.db"
  },
  "Backup": {
    "Enabled": true,
    "Path": "/app/backups",
    "Time": "03:00",
    "TimeZone": "Europe/Berlin",
    "KeepDaily": 14,
    "KeepWeekly": 8,
    "BeforeMigration": true
  },
  "Auth": {
    "LoginLink": {
      "ExpirationMinutes": 15
    },
    "Session": {
      "ExpirationDays": 14,
      "ValidationIntervalMinutes": 5
    },
    "PasskeyPolicy": {
      "RequiredForRoles": [ "SystemAdmin", "Manager" ]
    },
    "Passkeys": {
      "RelyingPartyId": "your-domain.com",
      "RelyingPartyName": "Vernetzt",
      "AllowedOrigins": [
        "https://your-domain.com"
      ],
      "ChallengeTimeoutSeconds": 300
    },
    "ContextEmailLoginHint": {
      "Enabled": true
    },
    "ContextEmailLoginHintCooldownMinutes": 60,
    "LoginLinkMaxPerUserPerHour": 5
  }
}

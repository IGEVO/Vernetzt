{
  "AllowedHosts": "vernetzt.example.org",
  "App": {
    "SystemAdminEmail": "admin@vernetzt.example.org",
    "BaseUrl": "https://vernetzt.example.org",
    "AuditLogRetentionDays": 90,
    "ExpiredTokenRetentionDays": 30
  },
  "Health": {
    "Token": ""
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": [
      "127.0.0.1"
    ],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.example.org",
      "Port": 587,
      "UseSsl": true,
      "Username": "smtp-user",
      "Password": "CHANGE-THIS-SMTP-PASSWORD"
    },
    "From": {
      "Address": "noreply@vernetzt.example.org",
      "Name": "Vernetzt"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/vernetzt.db"
  },
  "Auth": {
    "LoginLink": {
      "ExpirationMinutes": 15
    },
    "Session": {
      "ExpirationDays": 14,
      "ValidationIntervalMinutes": 5
    },
    "Passkeys": {
      "RelyingPartyId": "vernetzt.example.org",
      "RelyingPartyName": "Vernetzt",
      "AllowedOrigins": [
        "https://vernetzt.example.org"
      ],
      "ChallengeTimeoutSeconds": 300
    },
    "ContextEmailLoginHint": {
      "Enabled": true
    },
    "ContextEmailLoginHintCooldownMinutes": 60
  }
}

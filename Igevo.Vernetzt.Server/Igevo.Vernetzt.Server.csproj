<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Igevo.Vernetzt.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Igevo.Vernetzt.Core\Igevo.Vernetzt.Core.csproj" />
    <ProjectReference Include="..\Igevo.Vernetzt.Infrastructure\Igevo.Vernetzt.Infrastructure.csproj" />
    <ProjectReference Include="..\Igevo.Vernetzt.ServiceDefaults\Igevo.Vernetzt.ServiceDefaults.csproj" />
  </ItemGroup>

  <Target Name="BuildVueApp" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipVueBuild)' != 'true'">
    <Exec WorkingDirectory="..\Igevo.Vernetzt.WebApp" Command="npm ci" />
    <Exec WorkingDirectory="..\Igevo.Vernetzt.WebApp" Command="npm run build" />
    <ItemGroup>
      <VueDistFile Include="..\Igevo.Vernetzt.WebApp\dist\**\*" />
      <ResolvedFileToPublish Include="@(VueDistFile->'%(FullPath)')">
        <RelativePath>wwwroot\%(VueDistFile.RecursiveDir)%(VueDistFile.Filename)%(VueDistFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

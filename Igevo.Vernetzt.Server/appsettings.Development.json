{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
    }
  },
  "App": {
    "SystemAdminEmail": "admin@test.de",
    "BaseUrl": "http://localhost:5173",
    "SeedDevelopmentData": true
  },
  "Health": {
    "Token": "dev-health-token"
  },
  "PublicApi": {
    "AccessKey": "dev-public-api-key-not-for-production"
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": [],
    "ForwardLimit": 2
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseSsl": false,
      "Username": "",
      "Password": ""
    },
    "From": {
      "Address": "noreply@vernetzt.local",
      "Name": "Vernetzt Development"
    },
    "Retry": {
      "MaxRetries": 2,
      "InitialDelaySeconds": 1,
      "UseExponentialBackoff": true,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerDurationSeconds": 60
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/vernetzt.db"
  },
  "Backup": {
    "Path": "App_Data/backups"
  },
  "Auth": {
    "LoginLink": {
      "ExpirationMinutes": 30
    },
    "Session": {
      "ExpirationDays": 30,
      "ValidationIntervalMinutes": 5
    },
    "Passkeys": {
      "RelyingPartyId": "localhost",
      "RelyingPartyName": "Vernetzt (Development)",
      "AllowedOrigins": [
        "http://localhost:5173",
        "http://localhost:5142",
        "http://localhost:5122",
        "http://localhost:15888",
        "https://localhost:17228"
      ],
      "ChallengeTimeoutSeconds": 300
    },
    "ContextEmailLoginHint": {
      "Enabled": true
    },
    "ContextEmailLoginHintCooldownMinutes": 60
  },
  "EmailRelay": {
    "Enabled": true,
    "TokenValidityMinutes": 30,
    "PollingIntervalSeconds": 15,
    "BaseAddress": "relay@vernetzt.local",
    "AddressingMode": "PlusAddressing",
    "MonitorMode": "Pop3",
    "AddInfoBanner": true,
    "SendSummaryReply": true,
    "MaxActiveTokensPerUser": 10,
    "Imap": {
      "Host": "localhost",
      "Port": 1143,
      "UseSsl": false,
      "Username": "relay",
      "Password": "relay"
    },
    "Pop3": {
      "Host": "localhost",
      "Port": 1110,
      "UseSsl": false,
      "Username": "relay",
      "Password": "relay"
    }
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  }
}

<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>7f76f9a5-bd3e-4eba-9c83-1e0d47a8c5e4</UserSecretsId>
    <!-- DCP and the dashboard come from NuGet; the AppHost runs via dotnet run/watch without the Aspire CLI bundle -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Igevo.Vernetzt.Server\Igevo.Vernetzt.Server.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

</Project>
